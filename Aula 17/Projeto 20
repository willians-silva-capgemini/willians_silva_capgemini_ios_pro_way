// Importações
import SwiftUI
import Observation // iOS 17 ou superior

// Classe de Perfil
@Observable
class Perfil {
    
    // Características
    var nome: String = "Aline da Silva"
    var seguidores: Int = 460
    
    // Função para incrementar os seguidores
    func addSeguidores() {
        seguidores += 1
    }
    
}

// ContentView
struct ContentView: View {
    
    // Criar referência do tipo Perfil
    @State private var perfil = Perfil()
    
    // Body
    var body: some View {
        
        // Englobar estrutura
        VStack {
            
            // Card
            VStack(spacing: 10) {
                Image(systemName: "figure.stand.dress")
                    .font(.system(size: 80))
                    .foregroundStyle(.purple)
                
                Text(perfil.nome)
                    .font(.title)
                
                Text("Seguidores: \(perfil.seguidores)")
                    .bold()
                    .foregroundStyle(.gray)
            }
            .frame(width: 300, height: 200)
            .padding()
            .glassEffect(.regular, in: .rect(cornerRadius: 20))
            
            // Botão para add
            Button(action: {
                perfil.addSeguidores()
            }) {
                Label("Adicionar", systemImage: "plus.circle.fill")
            }
            .padding(.top, 30)
            
        }
        
    }
}

// Preview
#Preview {
    ContentView()
}



