// Trailing Closure
let calculoSurpresa1: (
    _ numero1: Double,
    _ numero2: Double,
    _ operacao: (Double, Double) -> Double
) -> Double = {
    n1, n2, op in
    op(n1, n2)
}

let calculoSurpresa2: (
    Double,
    Double,
    (Double, Double) -> Double
) -> Double = {
    n1, n2, op in
    op(n1, n2)
}

print(calculoSurpresa1(4, 5, {$0 + $1}))
print(calculoSurpresa2(3, 6) {$0 * $1})
