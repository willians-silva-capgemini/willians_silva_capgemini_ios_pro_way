// Closures -> Função anônima (Lambda ou Arrow Function)

// 1º Função convencional
func soma1(_ numero1: Int, _ numero2: Int) -> Int {
    return numero1 + numero2
}

// 2º Closure
let soma2: (_ numero1: Int, _ numero2: Int) -> Int = { n1, n2 in
    return n1 + n2
}

let soma3: (_ numero1: Int, _ numero2: Int) -> Int = {
    $0 + $1
}

