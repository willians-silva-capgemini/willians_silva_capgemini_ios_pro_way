// GAUGE componente disponível a partir do iOS 16
import SwiftUI

struct ContentView: View {
    
    // Variáveis
    @State private var bateria = 0.70
    @State private var passos = 4000.0
    
    // Body
    var body: some View {
        
        // VStack
        VStack {
            
            // Gauge - Barra
            VStack {
                Text("Progresso de passos (Meta 10.000)")
                    .font(.headline)
                
                Gauge(value: passos, in: 0...10000) {
                    Image(systemName: "shoe.running.and.shadow.fill")
                        .font(.largeTitle)
                        .padding(.bottom, 20)
                }
                .tint(.green)
                
            }
           
            // Divisão
            Divider()
                .padding()
            
            // Gauge - Círculo
            VStack {
                Text("Nível da bateria")
                    .font(.headline)
                    .padding(.bottom, 30)
                
                Gauge(value: bateria, in: 0...1) {
                    Image(systemName: "bolt").font(.largeTitle)
                }
                .gaugeStyle(.accessoryCircularCapacity)
                .tint(.yellow)
                .scaleEffect(1.5)
            }
            
            
        }
        .padding()
        
    }
}

