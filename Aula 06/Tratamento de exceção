// Definir o Enums
enum ErroAutenticacao: Error {
    case nomeUsuario(nome: String)
    case senhaUsuario(senha: String)
}

// Função que irá utilizar o Enums como base
func autenticarUsuario(nome: String, senha: String) throws -> String  {
    // Validar se o nome é admin
    if nome != "admin" {
        throw ErroAutenticacao.nomeUsuario(nome: nome)
    }
    
    // Validar se a senha é 123
    if senha != "123" {
        throw ErroAutenticacao.senhaUsuario(senha: senha)
    }
    
    // Caso informe admin e 123, retorna um token
    return "Ab6Ty45w0"
}

