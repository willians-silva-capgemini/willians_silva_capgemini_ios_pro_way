// Importar SwiftUI
import SwiftUI

// Estrutura da tela
struct ContentView: View {
    
    // Variável para exibir/ocultar o alerta
    @State private var exibir: Bool = false
    @State private var resposta: String = "Aguardando resposta do cliente..."
    
    // Exibir componentes 
    var body: some View {
        
        // VStack
        VStack {
            
            // Exibir o valor da variável resposta
            Text(resposta)
            
            // Botão
            Button("Clique aqui") {
                exibir = true
            }
                .buttonStyle(.borderedProminent)
                .alert("Está gostando de SwiftUI?", isPresented: $exibir) {
                    Button("Sim") {
                        resposta = "👍 Sim!"
                    }
                    Button("Não") {
                        resposta = "👎 Não!"
                    }
                }
                
        }
        
    }
}

// Visualizar tela via Canvas
#Preview {
    ContentView()
}
